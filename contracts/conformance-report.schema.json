{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarmg.org/schemas/conformance-report-v1.json",
  "type": "object",
  "required": ["schema_version", "contract", "mode", "generated_at", "projects", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "org.sarmg.http@1.0.0" },
    "mode": { "enum": ["inventory", "live"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "projects": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "checks", "summary"],
        "properties": {
          "id": { "type": "string" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "category", "status", "message"],
              "properties": {
                "status": { "enum": ["pass", "fail", "waived", "not_run"] }
              }
            }
          }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
